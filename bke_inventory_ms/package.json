{
  "name": "bkm_inventory_ms",
  "version": "1.0.0",
  "description": "Microservicio de Inventario - Arquitectura Empresarial Node.js",
  "main": "dist/Microservicio.Inventory.Api/Program.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/Microservicio.Inventory.Api/Program.js",
    "dev": "ts-node-dev --respawn --transpile-only src/Microservicio.Inventory.Api/Program.ts",
    "prisma:generate": "node_modules/.bin/prisma generate",
    "prisma:migrate:dev": "node_modules/.bin/prisma migrate dev",
    "prisma:migrate:deploy": "node_modules/.bin/prisma migrate deploy",
    "prisma:studio": "node_modules/.bin/prisma studio"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "prisma": "5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
