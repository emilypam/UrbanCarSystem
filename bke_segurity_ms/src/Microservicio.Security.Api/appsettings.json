{
  "server": {
    "port": 3000
  },
  "jwt": {
    "expiresIn": "24h",
    "refreshExpiresIn": "7d"
  },
  "cors": {
    "origins": ["http://localhost:3000", "http://localhost:4200"]
  },
  "rateLimit": {
    "windowMinutes": 15,
    "maxRequests": 200
  },
  "logging": {
    "level": "info"
  }
}
