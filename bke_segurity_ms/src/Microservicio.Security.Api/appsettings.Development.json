{
  "server": {
    "port": 3000
  },
  "jwt": {
    "expiresIn": "1h",
    "refreshExpiresIn": "3d"
  },
  "cors": {
    "origins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:5173"
    ]
  },
  "rateLimit": {
    "windowMinutes": 15,
    "maxRequests": 1000
  },
  "logging": {
    "level": "debug",
    "prismaQueryLog": true
  }
}
